{
  "name": "7c-commander",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "prebuild": "prisma generate",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "backend:typecheck": "tsc -p tsconfig.backend.json --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "test:e2e:setup": "node scripts/setup-playwright.mjs",
    "test:e2e:setup:linux-deps": "node scripts/setup-playwright.mjs --with-deps",
    "pretest:e2e": "npm run test:e2e:setup",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "@google/genai": "^1.38.0",
    "googleapis": "^150.0.1",
    "lucide-react": "^0.454.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.1.0",
    "remark-gfm": "^4.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@vercel/node": "^3.2.28",
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright-chromium": "^1.58.2",
    "playwright-core": "^1.58.2",
    "postcss": "^8.4.49",
    "prisma": "^6.7.0",
    "source-map": "^0.7.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
